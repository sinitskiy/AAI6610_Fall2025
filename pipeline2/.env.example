# AAI6610 Pipeline - Environment Variables
# 请将此文件保存为 .env 在项目根目录

# ========================================
# OpenAI API (用于Clustering - Embeddings)
# ========================================
OPENAI_API_KEY=open_ai_key

# ========================================
# Google Custom Search API (用于LinkedIn)
# ========================================
GOOGLE_API_KEY=google_api_key
GOOGLE_SEARCH_ENGINE_ID=google_search_engine

# ========================================
# Reddit API
# ========================================
REDDIT_CLIENT_ID=redit_client_id
REDDIT_CLIENT_SECRET=reddit_client_secret
REDDIT_USER_AGENT=python:ml_post_scraper:v1.0 (by u/Ok-Mobile-2410)

# ========================================
# Academic Paper APIs
# ========================================
# Unpaywall API
UNPAYWALL_EMAIL=email

# OpenReview API
OPENREVIEW_MAILTO=email

# OpenAlex API (通常不需要key，但需要User-Agent)
OPENALEX_USER_AGENT=use_agent

# ========================================
# API Base URLs (一般不需要修改)
# ========================================
OPENALEX_BASE_URL=https://api.openalex.org
UNPAYWALL_BASE_URL=https://api.unpaywall.org/v2
OPENREVIEW_BASE_URL=https://api.openreview.net

# ========================================
# Pipeline Settings
# ========================================
PROJECT_NAME=AAI6610_WholePipeline
RESEARCH_TOPIC=uncertainty estimation in machine learning
LOG_LEVEL=INFO

# 新闻API (可选,免费版每天100次请求)
NEWS_API_KEY=news_api_key